# escape=`
# MetroLMS Unified Windows Server 2022 Container (Frontend + Backend on :8000)
# Usage:
#   docker compose -f docker-compose.windows.yml up -d --build

ARG WINDOWS_BASE_TAG=ltsc2022

# ------------------------------------------------------------------------------
# Stage 1: Build Production Frontend (frontend/dist)
# ------------------------------------------------------------------------------
FROM mcr.microsoft.com/windows/servercore:${WINDOWS_BASE_TAG} AS frontend-builder

SHELL ["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

ARG NODE_VERSION=24.11.0
RUN Invoke-WebRequest -Uri "https://nodejs.org/dist/v$env:NODE_VERSION/node-v$env:NODE_VERSION-win-x64.zip" -OutFile C:\node.zip; `
    Expand-Archive C:\node.zip -DestinationPath C:\; `
    Rename-Item "C:\node-v$env:NODE_VERSION-win-x64" C:\nodejs; `
    Remove-Item C:\node.zip -Force

ENV PATH="C:\nodejs;${PATH}"

WORKDIR C:\build\frontend
COPY frontend\package.json frontend\package-lock.json .\
RUN & "C:\nodejs\npm.cmd" ci

COPY frontend\ .\
COPY Demo\mocks C:\build\Demo\mocks
ARG VITE_SHOW_TEST_CARDS=true
ENV VITE_SHOW_TEST_CARDS=${VITE_SHOW_TEST_CARDS}
RUN & "C:\nodejs\npx.cmd" vite build

# ------------------------------------------------------------------------------
# Stage 2: Python 3.12 + ODBC Driver 18 + Waitress + WhiteNoise Runtime
# ------------------------------------------------------------------------------
FROM mcr.microsoft.com/windows/servercore:${WINDOWS_BASE_TAG}

SHELL ["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'SilentlyContinue';"]

ARG PYTHON_VERSION=3.12.10
RUN Invoke-WebRequest -Uri "https://www.python.org/ftp/python/$env:PYTHON_VERSION/python-$env:PYTHON_VERSION-amd64.exe" -OutFile C:\python-installer.exe; `
    Start-Process -Wait -FilePath C:\python-installer.exe -ArgumentList '/quiet InstallAllUsers=1 PrependPath=1 Include_test=0'; `
    Remove-Item C:\python-installer.exe -Force

# Install VC++ 2015-2022 Redistributable + Microsoft ODBC Driver 18 for SQL Server
RUN Invoke-WebRequest -Uri "https://aka.ms/vs/17/release/vc_redist.x64.exe" -OutFile C:\vc_redist.x64.exe; `
    $vc = Start-Process -Wait -PassThru -FilePath C:\vc_redist.x64.exe -ArgumentList '/install /quiet /norestart'; `
    if ($vc.ExitCode -ne 0 -and $vc.ExitCode -ne 3010) { throw "VC_REDIST_INSTALL_FAILED: $($vc.ExitCode)" }; `
    Remove-Item C:\vc_redist.x64.exe -Force; `
    Invoke-WebRequest -Uri "https://go.microsoft.com/fwlink/?linkid=2378279" -OutFile C:\msodbcsql.msi; `
    $odbc = Start-Process -Wait -PassThru -FilePath msiexec.exe -ArgumentList '/i C:\msodbcsql.msi /qn /norestart IACCEPTMSODBCSQLLICENSETERMS=YES ADDLOCAL=ALL /L*v C:\odbc18-install.log'; `
    if ($odbc.ExitCode -ne 0 -and $odbc.ExitCode -ne 3010) { Get-Content C:\odbc18-install.log -Tail 60; throw "ODBC_DRIVER_18_INSTALL_FAILED: $($odbc.ExitCode)" }; `
    Remove-Item C:\msodbcsql.msi, C:\odbc18-install.log -Force -ErrorAction SilentlyContinue

WORKDIR C:\app\backend
COPY backend\requirements.txt backend\requirements-prod.txt .\
RUN python -m pip install --no-cache-dir --upgrade pip; `
    python -m pip install --no-cache-dir -r requirements-prod.txt
RUN ["python", "-c", "import pyodbc; drivers = pyodbc.drivers(); print('ODBC drivers:', drivers); assert 'ODBC Driver 18 for SQL Server' in drivers, f'Missing ODBC Driver 18: {drivers}'"]

COPY backend\ .\
COPY --from=frontend-builder C:\build\frontend\dist C:\app\frontend\dist

RUN New-Item -ItemType Directory -Force -Path C:\MetroLMSMedia, C:\app\backend\staticfiles, C:\ffmpeg\bin | Out-Null; `
    Invoke-WebRequest -Uri "https://www.gyan.dev/ffmpeg/builds/ffmpeg-release-essentials.zip" -OutFile C:\ffmpeg.zip; `
    Expand-Archive C:\ffmpeg.zip -DestinationPath C:\ffmpeg-tmp; `
    $ffBin = Get-ChildItem C:\ffmpeg-tmp -Recurse -Filter "ffmpeg.exe" | Select-Object -First 1 -ExpandProperty DirectoryName; `
    Copy-Item (Join-Path $ffBin "ffmpeg.exe") C:\ffmpeg\bin\ffmpeg.exe -Force; `
    Copy-Item (Join-Path $ffBin "ffprobe.exe") C:\ffmpeg\bin\ffprobe.exe -Force; `
    Remove-Item C:\ffmpeg.zip, C:\ffmpeg-tmp -Recurse -Force

ENV PYTHONUNBUFFERED=1 `
    METROLMS_SERVE_FRONTEND=True `
    METROLMS_FRONTEND_DIST_DIR=C:\app\frontend\dist `
    METROLMS_MEDIA_ROOT=C:\MetroLMSMedia `
    METROLMS_FFMPEG_PATH=C:\ffmpeg\bin\ffmpeg.exe `
    METROLMS_FFPROBE_PATH=C:\ffmpeg\bin\ffprobe.exe `
    PATH="C:\ffmpeg\bin;${PATH}"

EXPOSE 8000

CMD ["C:\\Windows\\System32\\WindowsPowerShell\\v1.0\\powershell.exe", "-Command", "$ErrorActionPreference = 'Stop'; if (-not $env:DB_HOST -or $env:DB_HOST -match '^(?i)auto$') { $gw = [System.Net.NetworkInformation.NetworkInterface]::GetAllNetworkInterfaces() | Where-Object { $_.OperationalStatus -eq 'Up' } | ForEach-Object { $_.GetIPProperties().GatewayAddresses } | Where-Object { $_.Address.AddressFamily -eq 'InterNetwork' } | Select-Object -First 1 -ExpandProperty Address | ForEach-Object { $_.IPAddressToString }; if ($gw) { $env:DB_HOST = $gw; Write-Host \"[INFO] Auto-detected DB_HOST gateway: $gw\" } }; if ($env:METROLMS_RUN_MIGRATIONS_ON_START -ne 'False') { python manage.py migrate --noinput }; waitress-serve --host=0.0.0.0 --port=8000 --threads=8 --max-request-body-size=2254857830 --channel-timeout=600 config.wsgi:application"]
