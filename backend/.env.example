# MetroLMS Backend Environment Template (Copy to .env — NEVER commit .env)
DJANGO_SETTINGS_MODULE=config.settings.development
DJANGO_SECRET_KEY=replace-with-secure-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Microsoft SQL Server 2022 (D-DB-01 — pyodbc + ODBC Driver 18)
DB_ENGINE=mssql
DB_NAME=MetroLMS
DB_USER=metrolms_app_user
DB_PASSWORD=replace-with-db-password
DB_HOST=localhost
DB_PORT=1433
DB_ODBC_DRIVER=ODBC Driver 18 for SQL Server

# Local Windows Media Storage (D-MEDIA-01 / INV-DOM21-06)
METROLMS_MEDIA_ROOT=D:\MetroLMSMedia

# Session & CSRF Security (D-AUTH-01)
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Logging
DJANGO_LOG_LEVEL=INFO
